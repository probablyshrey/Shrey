    prev=(struct node*)malloc(sizeof(struct node));
    struct node* new;
    new=(struct node*)malloc(sizeof(struct node));
    for (int i=0; i<=index; i++)
    {
        if (i==index-1)
        {
            prev=ptr;
        }
        if (i==index)
        {
            prev=ptr->next;
            break;
        }
        ptr=ptr->next;
    }
    return prev;
}
