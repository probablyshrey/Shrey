#include <stdio.h>
#include <stdlib.h>
struct node{
    int data;
    struct node* next;
};
struct node* createnode(struct node* head,int data){
    struct node* new;
    new=(struct node*)malloc(sizeof(struct node));
    new->data=data;
    new->next=head;
    head=new;
    return head;
}
void traverse(struct node* ptr){
    printf("CURRENT DATA: \n");
    while(ptr!=NULL)
    {
        printf("%d\n", ptr->data);
        ptr=ptr->next;
    }
}
void insertatend(struct node* ptr, int data){
    struct node* new;
    new=(struct node*)malloc(sizeof(struct node));
    while(1)
    {
        if (ptr->next==NULL)
        {
            ptr->next=new;
            new->data=data;
            new->next=NULL;
            break;
        }
        ptr=ptr->next;
    }
}
struct node* deletion(struct node* head,int  index){
    struct node* ptr;
    ptr=(struct node*)malloc(sizeof(struct node));
    ptr=head;
